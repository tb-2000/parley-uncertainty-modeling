module Knowledge
  kstate : [0..498] init 0;
  ready : [0..1] init 1;

  [east] ready=1 & kstate=0 -> (kstate'=100) & (ready'=0);
  [east] ready=1 & kstate=6 -> (kstate'=101) & (ready'=0);
