module Knowledge
  xhat : [0..N] init xstart;
  yhat : [0..N] init ystart;
  raw_state : [0..RAW_STATE_MAX] init 0;
  step : [1..10] init 1;
  ready : [0..1] init 1;

  [east] ready=1 & xhat=0 & yhat=0 & raw_state=0 -> (xhat'=1) & (yhat'=0) & (raw_state'=1) & (ready'=0);
  [east] ready=1 & xhat=0 & yhat=6 & raw_state=0 -> (xhat'=1) & (yhat'=6) & (raw_state'=4) & (ready'=0);
  [east] ready=1 & xhat=1 & yhat=0 & raw_state=0 -> (xhat'=2) & (yhat'=0) & (raw_state'=6) & (ready'=0);
  [east] ready=1 & xhat=1 & yhat=0 & raw_state=1 -> (xhat'=2) & (yhat'=0) & (raw_state'=10) & (ready'=0);
  [east] ready=1 & xhat=1 & yhat=0 & raw_state=8 -> (xhat'=2) & (yhat'=0) & (raw_state'=22) & (ready'=0);
  [south] ready=1 & xhat=1 & yhat=1 & raw_state=0 -> (xhat'=1) & (yhat'=0) & (raw_state'=8) & (ready'=0);
  [east] ready=1 & xhat=1 & yhat=3 & raw_state=0 -> (xhat'=2) & (yhat'=3) & (raw_state'=9) & (ready'=0);
  [east] ready=1 & xhat=1 & yhat=5 & raw_state=0 -> (xhat'=2) & (yhat'=5) & (raw_state'=9) & (ready'=0);
  [east] ready=1 & xhat=1 & yhat=6 & raw_state=0 -> (xhat'=2) & (yhat'=6) & (raw_state'=9) & (ready'=0);
