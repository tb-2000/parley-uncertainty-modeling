dtmc
const int c = 1;
const int N=9;
const int xstart = 0;
const int ystart = 0;
const int xtarget = 9;
const int ytarget = 9;
const double p = 0.01;

// HMM uncertainty level -> raw expected-squared-error threshold
// level 1 -> HMM-MSE >= 0.080000000000000002
// level 2 -> HMM-MSE >= 0.15030000000000002
// level 3 -> HMM-MSE >= 0.22389500000000001
// level 4 -> HMM-MSE >= 0.30078311000000002
// level 5 -> HMM-MSE >= 0.38298024670000003
// level 6 -> HMM-MSE >= 0.46290521870100004
// level 7 -> HMM-MSE >= 0.53185681409266006
// level 8 -> HMM-MSE >= 0.60173393919591622
// level 9 -> HMM-MSE >= 0.67166181007029546
// level 10 -> HMM-MSE >= 0.74208396442239888

formula hasCrashed = (1=0) | (x=0 & y=7) | (x=1 & y=2) | (x=1 & y=3) | (x=1 & y=6) | (x=2 & y=2) | (x=2 & y=4) | (x=2 & y=6) | (x=3 & y=6) | (x=3 & y=9) | (x=4 & y=3) | (x=4 & y=5) | (x=5 & y=1) | (x=5 & y=2) | (x=5 & y=4) | (x=5 & y=5) | (x=5 & y=6) | (x=5 & y=8) | (x=7 & y=1) | (x=7 & y=2) | (x=7 & y=4) | (x=7 & y=6) | (x=8 & y=8) | (x=9 & y=1) | (x=9 & y=4) | (x=9 & y=7) ;

formula update_required = (hmm_state=1 & c<=1) | (hmm_state=2 & c<=2) | (hmm_state=3 & c<=3) | (hmm_state=4 & c<=4) | (hmm_state=5 & c<=5) | (hmm_state=6 & c<=6) | (hmm_state=7 & c<=7) | (hmm_state=8 & c<=8) | (hmm_state=9 & c<=9) | (hmm_state=10);

module Robot 
  x : [0..N] init xstart;
  y : [0..N] init ystart;
  move_ready : [0..1] init 1;
  crashed : [0..1] init 0;

  [east] (move_ready=1) -> 
    (1-3*p): (x'=min(x+1, N)) & (move_ready'=0) + 
    p: (y'=min(y+1, N)) & (move_ready'=0) + 
    p: (y'=max(y-1, 0)) & (move_ready'=0) + 
    p: (x'=max(x-1, 0)) & (move_ready'=0); 
  [west] (move_ready=1) -> 
    p: (x'=min(x+1, N)) & (move_ready'=0) + 
    p: (y'=min(y+1, N)) & (move_ready'=0) + 
    p: (y'=max(y-1, 0)) & (move_ready'=0) + 
    (1-3*p): (x'=max(x-1, 0)) & (move_ready'=0); 
  [north] (move_ready=1) -> 
    p: (x'=min(x+1, N)) & (move_ready'=0) + 
    (1-3*p): (y'=min(y+1, N)) & (move_ready'=0) + 
    p: (y'=max(y-1, 0)) & (move_ready'=0) + 
    p: (x'=max(x-1, 0)) & (move_ready'=0); 
  [south] (move_ready=1) -> 
    p: (x'=min(x+1, N)) & (move_ready'=0) + 
    p: (y'=min(y+1, N)) & (move_ready'=0) + 
    (1-3*p): (y'=max(y-1, 0)) & (move_ready'=0) + 
    p: (x'=max(x-1, 0)) & (move_ready'=0); 

  [check] (move_ready=0) & hasCrashed -> (crashed'=1) & (move_ready'=1); 
  [check] (move_ready=0) & !hasCrashed -> (move_ready'=1); 
endmodule

