  [east] (xhat=4) & (yhat=9) -> true;
  [east] (xhat=5) & (yhat=0) -> true;
  [east] (xhat=5) & (yhat=3) -> true;
  [east] (xhat=5) & (yhat=7) -> true;
  [east] (xhat=5) & (yhat=9) -> true;
  [north] (xhat=6) & (yhat=0) -> true;
