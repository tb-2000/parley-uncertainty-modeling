  [east] (xhat=3) & (yhat=9) -> true;
  [north] (xhat=4) & (yhat=0) -> true;
  [east] (xhat=4) & (yhat=1) -> true;
  [south] (xhat=4) & (yhat=2) -> true;
  [south] (xhat=4) & (yhat=3) -> true;
  [north] (xhat=4) & (yhat=5) -> true;
  [east] (xhat=4) & (yhat=6) -> true;
  [south] (xhat=4) & (yhat=7) -> true;
  [east] (xhat=4) & (yhat=8) -> true;
  [south] (xhat=4) & (yhat=9) -> true;
  [north] (xhat=5) & (yhat=0) -> true;
  [east] (xhat=5) & (yhat=1) -> true;
  [east] (xhat=5) & (yhat=2) -> true;
  [north] (xhat=5) & (yhat=4) -> true;
  [north] (xhat=5) & (yhat=5) -> true;
  [east] (xhat=5) & (yhat=6) -> true;
  [north] (xhat=5) & (yhat=7) -> true;
  [east] (xhat=5) & (yhat=8) -> true;
  [north] (xhat=6) & (yhat=0) -> true;
  [north] (xhat=6) & (yhat=1) -> true;
  [north] (xhat=6) & (yhat=2) -> true;
  [north] (xhat=6) & (yhat=3) -> true;
  [north] (xhat=6) & (yhat=4) -> true;
  [north] (xhat=6) & (yhat=5) -> true;
  [east] (xhat=6) & (yhat=6) -> true;
  [east] (xhat=6) & (yhat=8) -> true;
  [west] (xhat=7) & (yhat=0) -> true;
  [west] (xhat=7) & (yhat=1) -> true;
  [west] (xhat=7) & (yhat=2) -> true;
  [west] (xhat=7) & (yhat=4) -> true;
  [north] (xhat=7) & (yhat=5) -> true;
  [north] (xhat=7) & (yhat=6) -> true;
  [north] (xhat=7) & (yhat=7) -> true;
  [north] (xhat=7) & (yhat=8) -> true;
  [east] (xhat=7) & (yhat=9) -> true;
  [west] (xhat=8) & (yhat=0) -> true;
  [west] (xhat=8) & (yhat=1) -> true;
  [south] (xhat=8) & (yhat=2) -> true;
  [west] (xhat=8) & (yhat=4) -> true;
  [west] (xhat=8) & (yhat=7) -> true;
  [east] (xhat=8) & (yhat=9) -> true;
  [west] (xhat=9) & (yhat=0) -> true;
  [west] (xhat=9) & (yhat=1) -> true;
  [north] (xhat=9) & (yhat=8) -> true;
endmodule

module Knowledge
  xhat : [0..N] init xstart;
  yhat : [0..N] init ystart;
  xradius : [0..N] init 0;
  yradius : [0..N] init 0;
  ready : [0..1] init 1;

  [west] ready=1 ->
    (xhat'=max(xhat-1, 0)) &
    (xradius'=min(xradius+2, N)) &
    (yradius'=min(yradius+1, N)) &
    (ready'=0);
  [east] ready=1 ->
    (xhat'=min(xhat+1, N)) &
    (xradius'=min(xradius+2, N)) &
    (yradius'=min(yradius+1, N)) &
    (ready'=0);
  [south] ready=1 ->
    (yhat'=max(yhat-1, 0)) &
    (xradius'=min(xradius+1, N)) &
    (yradius'=min(yradius+2, N)) &
    (ready'=0);
  [north] ready=1 ->
    (yhat'=min(yhat+1, N)) &
    (xradius'=min(xradius+1, N)) &
    (yradius'=min(yradius+2, N)) &
    (ready'=0);

  [update] update_required & ready=0 ->
    (xhat'=x) & (yhat'=y) &
    (xradius'=0) & (yradius'=0) &
    (ready'=1);
  [skip_update] !update_required & ready=0 -> (ready'=1);
endmodule

rewards "cost" 
  [east] true : 1; 
  [west] true : 1; 
  [north] true : 1; 
  [south] true : 1; 
  [update] true : 5;
endrewards 


