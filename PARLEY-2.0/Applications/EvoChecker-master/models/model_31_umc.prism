module URC
  max_interval_width : [5..18] init 5;
  [URC] true & xhat=0 & yhat=0 -> (max_interval_width'=decision_0_0=1 ? 5 : decision_0_0=2 ? 10 : decision_0_0=3 ? 13 : decision_0_0=4 ? 16 : decision_0_0=5 ? 17 : 18);
  [URC] true & xhat=0 & yhat=1 -> (max_interval_width'=decision_0_1=1 ? 5 : decision_0_1=2 ? 10 : decision_0_1=3 ? 13 : decision_0_1=4 ? 16 : decision_0_1=5 ? 17 : 18);
  [URC] true & xhat=0 & yhat=2 -> (max_interval_width'=decision_0_2=1 ? 5 : decision_0_2=2 ? 10 : decision_0_2=3 ? 13 : decision_0_2=4 ? 16 : decision_0_2=5 ? 17 : 18);
