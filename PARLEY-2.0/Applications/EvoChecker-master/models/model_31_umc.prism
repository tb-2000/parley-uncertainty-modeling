dtmc
const int N=9;
const int xstart = 0;
const int ystart = 0;
const int xtarget = 9;
const int ytarget = 9;
const double p = 0.01;
 
formula hasCrashed = (1=0) | (x=0 & y=2) | (x=0 & y=3) | (x=0 & y=7) | (x=0 & y=8) | (x=0 & y=9) | (x=1 & y=3) | (x=2 & y=1) | (x=2 & y=2) | (x=2 & y=6) | (x=2 & y=7) | (x=3 & y=4) | (x=3 & y=5) | (x=3 & y=7) | (x=3 & y=8) | (x=4 & y=4) | (x=5 & y=3) | (x=5 & y=9) | (x=6 & y=7) | (x=6 & y=9) | (x=7 & y=3) | (x=8 & y=3) | (x=8 & y=5) | (x=8 & y=6) | (x=8 & y=8) | (x=9 & y=2) | (x=9 & y=4) | (x=9 & y=7) ;

formula xlow = max(xhat-xradius, 0);
formula xhigh = min(xhat+xradius, N);
formula ylow = max(yhat-yradius, 0);
formula yhigh = min(yhat+yradius, N);
formula interval_width = (xhigh-xlow) + (yhigh-ylow);
formula update_required = interval_width>=max_interval_width;

module Robot 
  x : [0..N] init xstart;
  y : [0..N] init ystart;
  move_ready : [0..1] init 1;
  crashed : [0..1] init 0;

  [east] (move_ready=1) -> 
    (1-3*p): (x'=min(x+1, N)) & (move_ready'=0) + 
    p: (y'=min(y+1, N)) & (move_ready'=0) + 
    p: (y'=max(y-1, 0)) & (move_ready'=0) + 
    p: (x'=max(x-1, 0)) & (move_ready'=0); 
  [west] (move_ready=1) -> 
    p: (x'=min(x+1, N)) & (move_ready'=0) + 
    p: (y'=min(y+1, N)) & (move_ready'=0) + 
    p: (y'=max(y-1, 0)) & (move_ready'=0) + 
    (1-3*p): (x'=max(x-1, 0)) & (move_ready'=0); 
  [north] (move_ready=1) -> 
    p: (x'=min(x+1, N)) & (move_ready'=0) + 
    (1-3*p): (y'=min(y+1, N)) & (move_ready'=0) + 
    p: (y'=max(y-1, 0)) & (move_ready'=0) + 
    p: (x'=max(x-1, 0)) & (move_ready'=0); 
  [south] (move_ready=1) -> 
    p: (x'=min(x+1, N)) & (move_ready'=0) + 
    p: (y'=min(y+1, N)) & (move_ready'=0) + 
    (1-3*p): (y'=max(y-1, 0)) & (move_ready'=0) + 
    p: (x'=max(x-1, 0)) & (move_ready'=0); 

  [check] (move_ready=0) & hasCrashed -> (crashed'=1) & (move_ready'=1); 
  [check] (move_ready=0) & !hasCrashed -> (move_ready'=1); 
endmodule

module Adaptation_MAPE_controller
  [east] (xhat=0) & (yhat=0) -> true;
  [south] (xhat=0) & (yhat=1) -> true;
  [east] (xhat=0) & (yhat=4) -> true;
  [east] (xhat=0) & (yhat=5) -> true;
  [south] (xhat=0) & (yhat=6) -> true;
  [east] (xhat=1) & (yhat=0) -> true;
  [south] (xhat=1) & (yhat=1) -> true;
  [south] (xhat=1) & (yhat=2) -> true;
  [east] (xhat=1) & (yhat=4) -> true;
  [south] (xhat=1) & (yhat=5) -> true;
  [north] (xhat=1) & (yhat=6) -> true;
  [north] (xhat=1) & (yhat=7) -> true;
  [north] (xhat=1) & (yhat=8) -> true;
  [east] (xhat=1) & (yhat=9) -> true;
  [east] (xhat=2) & (yhat=0) -> true;
