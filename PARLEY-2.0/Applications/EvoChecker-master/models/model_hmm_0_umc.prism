module URC
  c : [1..10] init 1;
  [URC] true & xhat=0 & yhat=0 -> (c'=decision_0_0);
  [URC] true & xhat=0 & yhat=1 -> (c'=decision_0_1);
  [URC] true & xhat=0 & yhat=2 -> (c'=decision_0_2);
  [URC] true & xhat=0 & yhat=3 -> (c'=decision_0_3);
  [URC] true & xhat=0 & yhat=4 -> (c'=decision_0_4);
  [URC] true & xhat=1 & yhat=0 -> (c'=decision_1_0);
  [URC] true & xhat=1 & yhat=1 -> (c'=decision_1_1);
  [URC] true & xhat=1 & yhat=2 -> (c'=decision_1_2);
  [URC] true & xhat=1 & yhat=3 -> (c'=decision_1_3);
  [URC] true & xhat=1 & yhat=4 -> (c'=decision_1_4);
  [URC] true & xhat=2 & yhat=0 -> (c'=decision_2_0);
  [URC] true & xhat=2 & yhat=1 -> (c'=decision_2_1);
  [URC] true & xhat=2 & yhat=2 -> (c'=decision_2_2);
  [URC] true & xhat=2 & yhat=3 -> (c'=decision_2_3);
  [URC] true & xhat=2 & yhat=4 -> (c'=decision_2_4);
  [URC] true & xhat=3 & yhat=0 -> (c'=decision_3_0);
  [URC] true & xhat=3 & yhat=1 -> (c'=decision_3_1);
  [URC] true & xhat=3 & yhat=2 -> (c'=decision_3_2);
  [URC] true & xhat=3 & yhat=3 -> (c'=decision_3_3);
  [URC] true & xhat=3 & yhat=4 -> (c'=decision_3_4);
  [URC] true & xhat=4 & yhat=0 -> (c'=decision_4_0);
  [URC] true & xhat=4 & yhat=1 -> (c'=decision_4_1);
  [URC] true & xhat=4 & yhat=2 -> (c'=decision_4_2);
  [URC] true & xhat=4 & yhat=3 -> (c'=decision_4_3);
  [URC] true & xhat=4 & yhat=4 -> (c'=decision_4_4);
endmodule
module Turn
  t : [0..2] init 0;
  [east] (t=0) -> (t'=1);
  [west] (t=0) -> (t'=1);
  [north] (t=0) -> (t'=1);
  [south] (t=0) -> (t'=1);

  [URC] (t=1) -> (t'=2);

  [update] (t=2) -> (t'=0);
  [skip_update] (t=2) -> (t'=0);
endmodule
