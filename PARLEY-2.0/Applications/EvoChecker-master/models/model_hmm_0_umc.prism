dtmc
const int N=4;
const int xstart = 0;
const int ystart = 0;
const int xtarget = 4;
const int ytarget = 4;
const double p = 0.01;

// HMM uncertainty level -> raw expected-squared-error threshold
// level 1 -> HMM-MSE >= 0.070000000000000007
// level 2 -> HMM-MSE >= 0.1426
// level 3 -> HMM-MSE >= 0.21438100000000004
// level 4 -> HMM-MSE >= 0.25667767000000002
// level 5 -> HMM-MSE >= 0.3244804536
// level 6 -> HMM-MSE >= 0.38013061525000003
// level 7 -> HMM-MSE >= 0.44458687630291999
// level 8 -> HMM-MSE >= 0.48716508461939068
// level 9 -> HMM-MSE >= 0.48716508461939068
// level 10 -> HMM-MSE >= 0.48716508461939068

formula hasCrashed = (1=0) | (x=1 & y=0) | (x=1 & y=1) | (x=1 & y=3) | (x=2 & y=2) | (x=3 & y=0) | (x=3 & y=1) | (x=4 & y=2) ;

formula hmm_u_1 = (xhat=0 & yhat=2 & hmm_state=1) | (xhat=0 & yhat=2 & hmm_state=2) | (xhat=0 & yhat=2 & hmm_state=3) | (xhat=0 & yhat=3 & hmm_state=1) | (xhat=0 & yhat=4 & hmm_state=1) | (xhat=1 & yhat=4 & hmm_state=2) | (xhat=2 & yhat=4 & hmm_state=1) | (xhat=2 & yhat=4 & hmm_state=2) | (xhat=2 & yhat=4 & hmm_state=3) | (xhat=3 & yhat=3 & hmm_state=1) | (xhat=3 & yhat=4 & hmm_state=1) | (xhat=3 & yhat=4 & hmm_state=2) | (xhat=4 & yhat=4 & hmm_state=1) | (xhat=4 & yhat=4 & hmm_state=2) | (xhat=4 & yhat=4 & hmm_state=4);
formula hmm_u_2 = (xhat=0 & yhat=3 & hmm_state=2) | (xhat=0 & yhat=3 & hmm_state=3) | (xhat=0 & yhat=3 & hmm_state=4) | (xhat=0 & yhat=4 & hmm_state=2) | (xhat=1 & yhat=4 & hmm_state=3) | (xhat=2 & yhat=4 & hmm_state=4) | (xhat=3 & yhat=4 & hmm_state=3) | (xhat=3 & yhat=4 & hmm_state=4) | (xhat=3 & yhat=4 & hmm_state=5) | (xhat=3 & yhat=4 & hmm_state=6) | (xhat=4 & yhat=4 & hmm_state=3);
formula hmm_u_3 = (xhat=0 & yhat=4 & hmm_state=3) | (xhat=0 & yhat=4 & hmm_state=4) | (xhat=1 & yhat=4 & hmm_state=5) | (xhat=2 & yhat=4 & hmm_state=5) | (xhat=3 & yhat=4 & hmm_state=7) | (xhat=4 & yhat=4 & hmm_state=5) | (xhat=4 & yhat=4 & hmm_state=6) | (xhat=4 & yhat=4 & hmm_state=7);
formula hmm_u_4 = (xhat=0 & yhat=4 & hmm_state=5) | (xhat=1 & yhat=4 & hmm_state=4) | (xhat=1 & yhat=4 & hmm_state=6) | (xhat=2 & yhat=4 & hmm_state=7) | (xhat=4 & yhat=4 & hmm_state=8);
formula hmm_u_5 = (xhat=2 & yhat=4 & hmm_state=6) | (xhat=2 & yhat=4 & hmm_state=8) | (xhat=3 & yhat=4 & hmm_state=8) | (xhat=3 & yhat=4 & hmm_state=10) | (xhat=4 & yhat=4 & hmm_state=9);
formula hmm_u_6 = (xhat=3 & yhat=4 & hmm_state=9) | (xhat=4 & yhat=4 & hmm_state=10) | (xhat=4 & yhat=4 & hmm_state=12);
formula hmm_u_7 = (xhat=3 & yhat=4 & hmm_state=11) | (xhat=4 & yhat=4 & hmm_state=11);
formula hmm_u_10 = (xhat=4 & yhat=4 & hmm_state=13);
formula update_required = (hmm_u_1 & c<=1) | (hmm_u_2 & c<=2) | (hmm_u_3 & c<=3) | (hmm_u_4 & c<=4) | (hmm_u_5 & c<=5) | (hmm_u_6 & c<=6) | (hmm_u_7 & c<=7) | hmm_u_10;

module Robot 
  x : [0..N] init xstart;
  y : [0..N] init ystart;
  move_ready : [0..1] init 1;
  crashed : [0..1] init 0;

  [east] (move_ready=1) -> 
    (1-3*p): (x'=min(x+1, N)) & (move_ready'=0) + 
    p: (y'=min(y+1, N)) & (move_ready'=0) + 
    p: (y'=max(y-1, 0)) & (move_ready'=0) + 
    p: (x'=max(x-1, 0)) & (move_ready'=0); 
  [west] (move_ready=1) -> 
    p: (x'=min(x+1, N)) & (move_ready'=0) + 
    p: (y'=min(y+1, N)) & (move_ready'=0) + 
    p: (y'=max(y-1, 0)) & (move_ready'=0) + 
    (1-3*p): (x'=max(x-1, 0)) & (move_ready'=0); 
  [north] (move_ready=1) -> 
    p: (x'=min(x+1, N)) & (move_ready'=0) + 
    (1-3*p): (y'=min(y+1, N)) & (move_ready'=0) + 
    p: (y'=max(y-1, 0)) & (move_ready'=0) + 
    p: (x'=max(x-1, 0)) & (move_ready'=0); 
  [south] (move_ready=1) -> 
    p: (x'=min(x+1, N)) & (move_ready'=0) + 
    p: (y'=min(y+1, N)) & (move_ready'=0) + 
    (1-3*p): (y'=max(y-1, 0)) & (move_ready'=0) + 
    p: (x'=max(x-1, 0)) & (move_ready'=0); 

  [check] (move_ready=0) & hasCrashed -> (crashed'=1) & (move_ready'=1); 
  [check] (move_ready=0) & !hasCrashed -> (move_ready'=1); 
endmodule

module Adaptation_MAPE_controller
  [north] (xhat=0) & (yhat=0) -> true;
  [north] (xhat=0) & (yhat=1) -> true;
  [north] (xhat=0) & (yhat=2) -> true;
  [north] (xhat=0) & (yhat=3) -> true;
  [east] (xhat=0) & (yhat=4) -> true;
  [west] (xhat=1) & (yhat=2) -> true;
  [east] (xhat=1) & (yhat=4) -> true;
  [north] (xhat=2) & (yhat=3) -> true;
  [east] (xhat=2) & (yhat=4) -> true;
  [north] (xhat=3) & (yhat=2) -> true;
  [north] (xhat=3) & (yhat=3) -> true;
  [east] (xhat=3) & (yhat=4) -> true;
  [north] (xhat=4) & (yhat=3) -> true;
endmodule

module Knowledge
  xhat : [0..N] init xstart;
  yhat : [0..N] init ystart;
  hmm_state : [0..13] init 0;
  ready : [0..1] init 1;

  [north] ready=1 & xhat=0 & yhat=0 & hmm_state=0 -> (xhat'=0) & (yhat'=1) & (hmm_state'=1) & (ready'=0);
  [north] ready=1 & xhat=0 & yhat=1 & hmm_state=0 -> (xhat'=0) & (yhat'=2) & (hmm_state'=1) & (ready'=0);
  [north] ready=1 & xhat=0 & yhat=1 & hmm_state=1 -> (xhat'=0) & (yhat'=2) & (hmm_state'=3) & (ready'=0);
  [north] ready=1 & xhat=0 & yhat=2 & hmm_state=0 -> (xhat'=0) & (yhat'=3) & (hmm_state'=1) & (ready'=0);
  [north] ready=1 & xhat=0 & yhat=2 & hmm_state=1 -> (xhat'=0) & (yhat'=3) & (hmm_state'=2) & (ready'=0);
  [north] ready=1 & xhat=0 & yhat=2 & hmm_state=2 -> (xhat'=0) & (yhat'=3) & (hmm_state'=3) & (ready'=0);
  [north] ready=1 & xhat=0 & yhat=2 & hmm_state=3 -> (xhat'=0) & (yhat'=3) & (hmm_state'=4) & (ready'=0);
  [north] ready=1 & xhat=0 & yhat=3 & hmm_state=0 -> (xhat'=0) & (yhat'=4) & (hmm_state'=1) & (ready'=0);
  [north] ready=1 & xhat=0 & yhat=3 & hmm_state=1 -> (xhat'=0) & (yhat'=4) & (hmm_state'=2) & (ready'=0);
  [north] ready=1 & xhat=0 & yhat=3 & hmm_state=2 -> (xhat'=0) & (yhat'=4) & (hmm_state'=3) & (ready'=0);
  [north] ready=1 & xhat=0 & yhat=3 & hmm_state=3 -> (xhat'=0) & (yhat'=4) & (hmm_state'=4) & (ready'=0);
  [north] ready=1 & xhat=0 & yhat=3 & hmm_state=4 -> (xhat'=0) & (yhat'=4) & (hmm_state'=5) & (ready'=0);
  [east] ready=1 & xhat=0 & yhat=4 & hmm_state=0 -> (xhat'=1) & (yhat'=4) & (hmm_state'=1) & (ready'=0);
  [east] ready=1 & xhat=0 & yhat=4 & hmm_state=1 -> (xhat'=1) & (yhat'=4) & (hmm_state'=2) & (ready'=0);
  [east] ready=1 & xhat=0 & yhat=4 & hmm_state=2 -> (xhat'=1) & (yhat'=4) & (hmm_state'=3) & (ready'=0);
  [east] ready=1 & xhat=0 & yhat=4 & hmm_state=3 -> (xhat'=1) & (yhat'=4) & (hmm_state'=4) & (ready'=0);
  [east] ready=1 & xhat=0 & yhat=4 & hmm_state=4 -> (xhat'=1) & (yhat'=4) & (hmm_state'=5) & (ready'=0);
  [east] ready=1 & xhat=0 & yhat=4 & hmm_state=5 -> (xhat'=1) & (yhat'=4) & (hmm_state'=6) & (ready'=0);
  [west] ready=1 & xhat=1 & yhat=2 & hmm_state=0 -> (xhat'=0) & (yhat'=2) & (hmm_state'=2) & (ready'=0);
  [east] ready=1 & xhat=1 & yhat=4 & hmm_state=0 -> (xhat'=2) & (yhat'=4) & (hmm_state'=1) & (ready'=0);
  [east] ready=1 & xhat=1 & yhat=4 & hmm_state=1 -> (xhat'=2) & (yhat'=4) & (hmm_state'=3) & (ready'=0);
  [east] ready=1 & xhat=1 & yhat=4 & hmm_state=2 -> (xhat'=2) & (yhat'=4) & (hmm_state'=4) & (ready'=0);
  [east] ready=1 & xhat=1 & yhat=4 & hmm_state=3 -> (xhat'=2) & (yhat'=4) & (hmm_state'=5) & (ready'=0);
  [east] ready=1 & xhat=1 & yhat=4 & hmm_state=4 -> (xhat'=2) & (yhat'=4) & (hmm_state'=6) & (ready'=0);
  [east] ready=1 & xhat=1 & yhat=4 & hmm_state=5 -> (xhat'=2) & (yhat'=4) & (hmm_state'=7) & (ready'=0);
  [east] ready=1 & xhat=1 & yhat=4 & hmm_state=6 -> (xhat'=2) & (yhat'=4) & (hmm_state'=8) & (ready'=0);
  [north] ready=1 & xhat=2 & yhat=3 & hmm_state=0 -> (xhat'=2) & (yhat'=4) & (hmm_state'=2) & (ready'=0);
  [east] ready=1 & xhat=2 & yhat=4 & hmm_state=0 -> (xhat'=3) & (yhat'=4) & (hmm_state'=1) & (ready'=0);
  [east] ready=1 & xhat=2 & yhat=4 & hmm_state=1 -> (xhat'=3) & (yhat'=4) & (hmm_state'=3) & (ready'=0);
  [east] ready=1 & xhat=2 & yhat=4 & hmm_state=2 -> (xhat'=3) & (yhat'=4) & (hmm_state'=4) & (ready'=0);
  [east] ready=1 & xhat=2 & yhat=4 & hmm_state=3 -> (xhat'=3) & (yhat'=4) & (hmm_state'=6) & (ready'=0);
  [east] ready=1 & xhat=2 & yhat=4 & hmm_state=4 -> (xhat'=3) & (yhat'=4) & (hmm_state'=7) & (ready'=0);
  [east] ready=1 & xhat=2 & yhat=4 & hmm_state=5 -> (xhat'=3) & (yhat'=4) & (hmm_state'=8) & (ready'=0);
  [east] ready=1 & xhat=2 & yhat=4 & hmm_state=6 -> (xhat'=3) & (yhat'=4) & (hmm_state'=9) & (ready'=0);
  [east] ready=1 & xhat=2 & yhat=4 & hmm_state=7 -> (xhat'=3) & (yhat'=4) & (hmm_state'=10) & (ready'=0);
  [east] ready=1 & xhat=2 & yhat=4 & hmm_state=8 -> (xhat'=3) & (yhat'=4) & (hmm_state'=11) & (ready'=0);
  [north] ready=1 & xhat=3 & yhat=2 & hmm_state=0 -> (xhat'=3) & (yhat'=3) & (hmm_state'=1) & (ready'=0);
  [north] ready=1 & xhat=3 & yhat=3 & hmm_state=0 -> (xhat'=3) & (yhat'=4) & (hmm_state'=2) & (ready'=0);
  [north] ready=1 & xhat=3 & yhat=3 & hmm_state=1 -> (xhat'=3) & (yhat'=4) & (hmm_state'=5) & (ready'=0);
  [east] ready=1 & xhat=3 & yhat=4 & hmm_state=0 -> (xhat'=4) & (yhat'=4) & (hmm_state'=1) & (ready'=0);
  [east] ready=1 & xhat=3 & yhat=4 & hmm_state=1 -> (xhat'=4) & (yhat'=4) & (hmm_state'=3) & (ready'=0);
  [east] ready=1 & xhat=3 & yhat=4 & hmm_state=2 -> (xhat'=4) & (yhat'=4) & (hmm_state'=4) & (ready'=0);
  [east] ready=1 & xhat=3 & yhat=4 & hmm_state=3 -> (xhat'=4) & (yhat'=4) & (hmm_state'=5) & (ready'=0);
  [east] ready=1 & xhat=3 & yhat=4 & hmm_state=4 -> (xhat'=4) & (yhat'=4) & (hmm_state'=6) & (ready'=0);
  [east] ready=1 & xhat=3 & yhat=4 & hmm_state=5 -> (xhat'=4) & (yhat'=4) & (hmm_state'=7) & (ready'=0);
  [east] ready=1 & xhat=3 & yhat=4 & hmm_state=6 -> (xhat'=4) & (yhat'=4) & (hmm_state'=8) & (ready'=0);
  [east] ready=1 & xhat=3 & yhat=4 & hmm_state=7 -> (xhat'=4) & (yhat'=4) & (hmm_state'=9) & (ready'=0);
  [east] ready=1 & xhat=3 & yhat=4 & hmm_state=8 -> (xhat'=4) & (yhat'=4) & (hmm_state'=10) & (ready'=0);
  [east] ready=1 & xhat=3 & yhat=4 & hmm_state=9 -> (xhat'=4) & (yhat'=4) & (hmm_state'=11) & (ready'=0);
  [east] ready=1 & xhat=3 & yhat=4 & hmm_state=10 -> (xhat'=4) & (yhat'=4) & (hmm_state'=12) & (ready'=0);
  [east] ready=1 & xhat=3 & yhat=4 & hmm_state=11 -> (xhat'=4) & (yhat'=4) & (hmm_state'=13) & (ready'=0);
  [north] ready=1 & xhat=4 & yhat=3 & hmm_state=0 -> (xhat'=4) & (yhat'=4) & (hmm_state'=2) & (ready'=0);

  [update] ready=0 & update_required -> (xhat'=x) & (yhat'=y) & (hmm_state'=0) & (ready'=1);
  [skip_update] ready=0 & !update_required -> (ready'=1);
endmodule

rewards "cost" 
  [east] true : 1; 
  [west] true : 1; 
  [north] true : 1; 
  [south] true : 1; 
  [update] true : 5;
endrewards 


evolve int decision_0_0 [1..10];
evolve int decision_0_1 [1..10];
evolve int decision_0_2 [1..10];
evolve int decision_0_3 [1..10];
evolve int decision_0_4 [1..10];
evolve int decision_1_0 [1..10];
evolve int decision_1_1 [1..10];
