  [east] (xhat=5) & (yhat=9) -> true;
  [east] (xhat=6) & (yhat=0) -> true;
  [south] (xhat=6) & (yhat=1) -> true;
  [east] (xhat=6) & (yhat=4) -> true;
  [east] (xhat=6) & (yhat=6) -> true;
  [east] (xhat=6) & (yhat=7) -> true;
  [north] (xhat=6) & (yhat=8) -> true;
