  [URC] true & xhat=0 & yhat=9 -> (max_gaussian_uncertainty'=decision_0_9);
  [URC] true & xhat=1 & yhat=0 -> (max_gaussian_uncertainty'=decision_1_0);
  [URC] true & xhat=1 & yhat=1 -> (max_gaussian_uncertainty'=decision_1_1);
  [URC] true & xhat=1 & yhat=2 -> (max_gaussian_uncertainty'=decision_1_2);
