module URC
  max_gaussian_uncertainty : [1..10] init 1;
  // Levels 1..10 refer to the raw MSE thresholds documented at the top of this model.
  [URC] true & xhat=0 & yhat=0 -> (max_gaussian_uncertainty'=decision_0_0);
  [URC] true & xhat=0 & yhat=1 -> (max_gaussian_uncertainty'=decision_0_1);
  [URC] true & xhat=0 & yhat=2 -> (max_gaussian_uncertainty'=decision_0_2);
