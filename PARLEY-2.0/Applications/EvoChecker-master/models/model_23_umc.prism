dtmc
// Gaussian uncertainty level -> raw MSE threshold
// level 1 -> MSE >= 80000
// level 2 -> MSE >= 150800
// level 3 -> MSE >= 234000
// level 4 -> MSE >= 311400
// level 5 -> MSE >= 394200
// level 6 -> MSE >= 477600
// level 7 -> MSE >= 564400
// level 8 -> MSE >= 657000
// level 9 -> MSE >= 737000
// level 10 -> MSE >= 815100
const int N=9;
const int xstart=0;
const int ystart=0;
const int xtarget=9;
const int ytarget=9;
const double p=0.01;

formula hasCrashed = (1=0) | (x=0 & y=4) | (x=0 & y=6) | (x=1 & y=1) | (x=1 & y=2) | (x=1 & y=3) | (x=1 & y=5) | (x=2 & y=1) | (x=2 & y=2) | (x=2 & y=5) | (x=2 & y=9) | (x=3 & y=2) | (x=3 & y=4) | (x=3 & y=7) | (x=4 & y=5) | (x=4 & y=8) | (x=5 & y=1) | (x=5 & y=7) | (x=5 & y=8) | (x=6 & y=2) | (x=6 & y=3) | (x=6 & y=5) | (x=7 & y=2) | (x=8 & y=2) | (x=9 & y=5) | (x=9 & y=6) ;

formula gaussian_u_level_0 = gstate=0 | gstate=1 | gstate=2 | gstate=3;
formula gaussian_u_level_1 = gstate=4 | gstate=5 | gstate=6 | gstate=7 | gstate=8 | gstate=9 | gstate=10 | gstate=11 | gstate=12 | gstate=13 | gstate=14;
formula gaussian_u_level_2 = gstate=15 | gstate=16 | gstate=17 | gstate=18 | gstate=19 | gstate=20 | gstate=21 | gstate=22 | gstate=23 | gstate=24 | gstate=25;
formula gaussian_u_level_3 = gstate=26 | gstate=27 | gstate=28 | gstate=29 | gstate=30 | gstate=31 | gstate=32 | gstate=33 | gstate=34 | gstate=35 | gstate=36 | gstate=37;
formula gaussian_u_level_4 = gstate=38 | gstate=39 | gstate=40 | gstate=41 | gstate=42 | gstate=43 | gstate=44 | gstate=45 | gstate=46 | gstate=47 | gstate=48;
formula gaussian_u_level_5 = gstate=49 | gstate=50 | gstate=51 | gstate=52 | gstate=53 | gstate=54 | gstate=55 | gstate=56 | gstate=57 | gstate=58 | gstate=59 | gstate=60 | gstate=61 | gstate=62 | gstate=63;
formula gaussian_u_level_6 = gstate=64 | gstate=65 | gstate=66 | gstate=67 | gstate=68 | gstate=69 | gstate=70 | gstate=71 | gstate=72 | gstate=73 | gstate=74;
formula gaussian_u_level_7 = gstate=75 | gstate=76 | gstate=77 | gstate=78 | gstate=79 | gstate=80 | gstate=81;
formula gaussian_u_level_8 = gstate=82 | gstate=83 | gstate=84 | gstate=85 | gstate=86 | gstate=87 | gstate=88 | gstate=89 | gstate=90;
formula gaussian_u_level_9 = gstate=91 | gstate=92 | gstate=93 | gstate=94 | gstate=95 | gstate=96 | gstate=97 | gstate=98;
formula gaussian_u_level_10 = gstate=99;
formula update_required = (gaussian_u_level_1 & (max_gaussian_uncertainty=1)) | (gaussian_u_level_2 & (max_gaussian_uncertainty=1 | max_gaussian_uncertainty=2)) | (gaussian_u_level_3 & (max_gaussian_uncertainty=1 | max_gaussian_uncertainty=2 | max_gaussian_uncertainty=3)) | (gaussian_u_level_4 & (max_gaussian_uncertainty=1 | max_gaussian_uncertainty=2 | max_gaussian_uncertainty=3 | max_gaussian_uncertainty=4)) | (gaussian_u_level_5 & (max_gaussian_uncertainty=1 | max_gaussian_uncertainty=2 | max_gaussian_uncertainty=3 | max_gaussian_uncertainty=4 | max_gaussian_uncertainty=5)) | (gaussian_u_level_6 & (max_gaussian_uncertainty=1 | max_gaussian_uncertainty=2 | max_gaussian_uncertainty=3 | max_gaussian_uncertainty=4 | max_gaussian_uncertainty=5 | max_gaussian_uncertainty=6)) | (gaussian_u_level_7 & (max_gaussian_uncertainty=1 | max_gaussian_uncertainty=2 | max_gaussian_uncertainty=3 | max_gaussian_uncertainty=4 | max_gaussian_uncertainty=5 | max_gaussian_uncertainty=6 | max_gaussian_uncertainty=7)) | (gaussian_u_level_8 & (max_gaussian_uncertainty=1 | max_gaussian_uncertainty=2 | max_gaussian_uncertainty=3 | max_gaussian_uncertainty=4 | max_gaussian_uncertainty=5 | max_gaussian_uncertainty=6 | max_gaussian_uncertainty=7 | max_gaussian_uncertainty=8)) | (gaussian_u_level_9 & (max_gaussian_uncertainty=1 | max_gaussian_uncertainty=2 | max_gaussian_uncertainty=3 | max_gaussian_uncertainty=4 | max_gaussian_uncertainty=5 | max_gaussian_uncertainty=6 | max_gaussian_uncertainty=7 | max_gaussian_uncertainty=8 | max_gaussian_uncertainty=9)) | (gaussian_u_level_10 & (max_gaussian_uncertainty=1 | max_gaussian_uncertainty=2 | max_gaussian_uncertainty=3 | max_gaussian_uncertainty=4 | max_gaussian_uncertainty=5 | max_gaussian_uncertainty=6 | max_gaussian_uncertainty=7 | max_gaussian_uncertainty=8 | max_gaussian_uncertainty=9 | max_gaussian_uncertainty=10));

module Robot
  x : [0..N] init xstart;
  y : [0..N] init ystart;
  move_ready : [0..1] init 1;
  crashed : [0..1] init 0;

  [east] (move_ready=1) ->
    (1-3*p): (x'=min(x+1,N)) & (move_ready'=0) +
    p: (y'=min(y+1,N)) & (move_ready'=0) +
    p: (y'=max(y-1,0)) & (move_ready'=0) +
    p: (x'=max(x-1,0)) & (move_ready'=0);
  [west] (move_ready=1) ->
    p: (x'=min(x+1,N)) & (move_ready'=0) +
    p: (y'=min(y+1,N)) & (move_ready'=0) +
    p: (y'=max(y-1,0)) & (move_ready'=0) +
    (1-3*p): (x'=max(x-1,0)) & (move_ready'=0);
  [north] (move_ready=1) ->
    p: (x'=min(x+1,N)) & (move_ready'=0) +
    (1-3*p): (y'=min(y+1,N)) & (move_ready'=0) +
    p: (y'=max(y-1,0)) & (move_ready'=0) +
    p: (x'=max(x-1,0)) & (move_ready'=0);
  [south] (move_ready=1) ->
    p: (x'=min(x+1,N)) & (move_ready'=0) +
    p: (y'=min(y+1,N)) & (move_ready'=0) +
    (1-3*p): (y'=max(y-1,0)) & (move_ready'=0) +
    p: (x'=max(x-1,0)) & (move_ready'=0);
  [check] (move_ready=0) & hasCrashed -> (crashed'=1) & (move_ready'=1);
  [check] (move_ready=0) & !hasCrashed -> (move_ready'=1);
endmodule

