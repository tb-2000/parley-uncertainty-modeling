dtmc
const int gaussian_threshold_1 = 100;
const int gaussian_threshold_2 = 200;
const int gaussian_threshold_3 = 300;
const int gaussian_threshold_4 = 400;
const int gaussian_threshold_5 = 400;
const int gaussian_threshold_6 = 500;
const int gaussian_threshold_7 = 600;
const int gaussian_threshold_8 = 700;
const int gaussian_threshold_9 = 700;
const int gaussian_threshold_10 = 800;
const int N=9;
const int xstart = 0;
const int ystart = 0;
const int xtarget = 9;
const int ytarget = 9;
const double p = 0.01;
const int GVAR_MAX = 22;
const int GSTATE_MAX = 92;

formula hasCrashed = (1=0) | (x=0 & y=1) | (x=0 & y=3) | (x=0 & y=4) | (x=0 & y=5) | (x=0 & y=7) | (x=1 & y=2) | (x=1 & y=4) | (x=1 & y=7) | (x=2 & y=2) | (x=2 & y=8) | (x=3 & y=3) | (x=3 & y=7) | (x=3 & y=9) | (x=5 & y=4) | (x=5 & y=8) | (x=6 & y=2) | (x=6 & y=8) | (x=7 & y=3) | (x=7 & y=5) | (x=7 & y=6) | (x=8 & y=8) | (x=9 & y=3) | (x=9 & y=6) ;

formula gaussian_u_0 = gvar=0;
formula gaussian_u_1 = gvar=1 | gvar=2;
formula gaussian_u_2 = gvar=3 | gvar=4;
formula gaussian_u_3 = gvar=5 | gvar=6 | gvar=7;
formula gaussian_u_4 = gvar=8 | gvar=9 | gvar=10;
formula gaussian_u_5 = gvar=11 | gvar=12 | gvar=13 | gvar=14;
formula gaussian_u_6 = gvar=15 | gvar=16 | gvar=17;
formula gaussian_u_7 = gvar=18 | gvar=19 | gvar=20;
formula gaussian_u_8 = gvar=21 | gvar=22;
formula update_required = (gaussian_u_0 & max_gaussian_uncertainty<=0) | (gaussian_u_1 & max_gaussian_uncertainty<=100) | (gaussian_u_2 & max_gaussian_uncertainty<=200) | (gaussian_u_3 & max_gaussian_uncertainty<=300) | (gaussian_u_4 & max_gaussian_uncertainty<=400) | (gaussian_u_5 & max_gaussian_uncertainty<=500) | (gaussian_u_6 & max_gaussian_uncertainty<=600) | (gaussian_u_7 & max_gaussian_uncertainty<=700) | (gaussian_u_8 & max_gaussian_uncertainty<=800);

// Gaussian covariance quantization: h=0.1
// trace(Sigma)=var_x+var_y, integer-scaled offline
// gstate = refined Markov state; gvar = quantized covariance class

module Robot 
  x : [0..N] init xstart;
  y : [0..N] init ystart;
  move_ready : [0..1] init 1;
  crashed : [0..1] init 0;

  [east] (move_ready=1) -> 
    (1-3*p): (x'=min(x+1, N)) & (move_ready'=0) + 
    p: (y'=min(y+1, N)) & (move_ready'=0) + 
    p: (y'=max(y-1, 0)) & (move_ready'=0) + 
    p: (x'=max(x-1, 0)) & (move_ready'=0); 
  [west] (move_ready=1) -> 
    p: (x'=min(x+1, N)) & (move_ready'=0) + 
    p: (y'=min(y+1, N)) & (move_ready'=0) + 
    p: (y'=max(y-1, 0)) & (move_ready'=0) + 
    (1-3*p): (x'=max(x-1, 0)) & (move_ready'=0); 
  [north] (move_ready=1) -> 
    p: (x'=min(x+1, N)) & (move_ready'=0) + 
    (1-3*p): (y'=min(y+1, N)) & (move_ready'=0) + 
    p: (y'=max(y-1, 0)) & (move_ready'=0) + 
    p: (x'=max(x-1, 0)) & (move_ready'=0); 
  [south] (move_ready=1) -> 
    p: (x'=min(x+1, N)) & (move_ready'=0) + 
    p: (y'=min(y+1, N)) & (move_ready'=0) + 
    (1-3*p): (y'=max(y-1, 0)) & (move_ready'=0) + 
    p: (x'=max(x-1, 0)) & (move_ready'=0); 

  [check] (move_ready=0) & hasCrashed -> (crashed'=1) & (move_ready'=1); 
  [check] (move_ready=0) & !hasCrashed -> (move_ready'=1); 
endmodule

