module Turn
  t : [0..2] init 0;
  [east] (t=0) -> (t'=1);
  [west] (t=0) -> (t'=1);
  [north] (t=0) -> (t'=1);
  [south] (t=0) -> (t'=1);

  [URC] (t=1) -> (t'=2);

  [update] (t=2) -> (t'=0);
  [skip_update] (t=2) -> (t'=0);
endmodule
