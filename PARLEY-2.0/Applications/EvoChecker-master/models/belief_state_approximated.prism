dtmc

const int c = 1;
const int N=9;
const int xstart = 0;
const int ystart = 0;
const int xtarget = 9;
const int ytarget = 9;
const double p = 0.01;

module Robot 
  x : [0..N] init xstart;
  y : [0..N] init ystart;
  move_ready : [0..1] init 1;
  crashed : [0..1] init 0;

  [east] (move_ready=1) -> 
    (1-3*p): (x'=min(x+1, N)) & (move_ready'=0) + 
    p: (y'=min(y+1, N)) & (move_ready'=0) + 
    p: (y'=max(y-1, 0)) & (move_ready'=0) + 
    p: (x'=max(x-1, 0)) & (move_ready'=0); 
  [west] (move_ready=1) -> 
    p: (x'=min(x+1, N)) & (move_ready'=0) + 
    p: (y'=min(y+1, N)) & (move_ready'=0) + 
    p: (y'=max(y-1, 0)) & (move_ready'=0) + 
    (1-3*p): (x'=max(x-1, 0)) & (move_ready'=0); 
  [north] (move_ready=1) -> 
    p: (x'=min(x+1, N)) & (move_ready'=0) + 
    (1-3*p): (y'=min(y+1, N)) & (move_ready'=0) + 
    p: (y'=max(y-1, 0)) & (move_ready'=0) + 
    p: (x'=max(x-1, 0)) & (move_ready'=0); 
  [south] (move_ready=1) -> 
    p: (x'=min(x+1, N)) & (move_ready'=0) + 
    p: (y'=min(y+1, N)) & (move_ready'=0) + 
    (1-3*p): (y'=max(y-1, 0)) & (move_ready'=0) + 
    p: (x'=max(x-1, 0)) & (move_ready'=0); 

  [check] (move_ready=0) & hasCrashed -> (crashed'=1) & (move_ready'=1); 
  [check] (move_ready=0) & !hasCrashed -> (crashed'=0) & (move_ready'=1); 
  [stucked] (crashed=1) -> true;
endmodule

module Knowledge
  //xhat : [0..N] init xstart;
  //yhat : [0..N] init ystart;

  // Approximation eines Bayes-Filters: Belief der 4 wahrscheinlichsten Kandidaten/Positionen
  // [x1,y1] ist der aussichtsreichste Kandidat, der ohne Fehler in jede korrekte Richtung geht
  x1 : [0..N] init xstart; 
  y1 : [0..N] init ystart;

  x2 : [0..N] init xstart;
  y2 : [0..N] init ystart;

  x3 : [0..N] init xstart;
  y3 : [0..N] init ystart;

  x4 : [0..N] init xstart;
  y4 : [0..N] init ystart;

  // disktretisierte belief states für die jeweiligen Kandidaten
  // 10 = hohes Vertauen, 0 = kein Vertauen
  b1 : [0..10] init 10;
  b2 : [0..10] init 0;
  b3 : [0..10] init 0;
  b4 : [0..10] init 0;

  step : [0..c] init 0;
  ready : [0..1] init 1;

  formula noMatch = !(x1=x & y1=y) & !(x2=x & y2=y) & !(x3=x & y3=y) & !(x4=x & y4=y)

  // nach jeder Bewegung wächst Unsicherheit über aktuelle Positionen
  // es wird angenommen, dass alle Hypothesen in die gleiche Richtung gehen!
  [west] ready=1 -> (x1'=max(x1-1,0)) & (x2'=max(x2-1,0)) & (x3'=max(x3-1,0)) & (x4'=max(x4-1,0)) & (b1'=max(b1-1,0)) & (b2'=max(b2-1,0)) & (b3'=max(b3-1,0)) & (b4'=max(b4-1,0)) & (ready'=0);
  [east] ready=1 -> (x1'=min(x1+1,N)) & (x2'=min(x2+1,N)) & (x3'=min(x3+1,N)) & (x4'=min(x4+1,N)) & (b1'=max(b1-1,0)) & (b2'=max(b2-1,0)) & (b3'=max(b3-1,0)) & (b4'=max(b4-1,0)) & (ready'=0);
  [north] ready=1 -> (y1'=min(y1+1,N)) & (y2'=min(y2+1,N)) & (y3'=min(y3+1,N)) & (y4'=min(y4+1,N)) & (b1'=max(b1-1,0)) & (b2'=max(b2-1,0)) & (b3'=max(b3-1,0)) & (b4'=max(b4-1,0)) & (ready'=0);
  [south] ready=1 -> (y1'=max(y1-1,0)) & (y2'=max(y2-1,0)) & (y3'=max(y3-1,0)) & (y4'=max(y4-1,0)) & (b1'=max(b1-1,0)) & (b2'=max(b2-1,0)) & (b3'=max(b3-1,0)) & (b4'=max(b4-1,0)) & (ready'=0);

  // ein Update reduziert Unsicherheit des aussichtsreichsten Kandidaten und erhöht Unsicherheit bei anderen
  [update] step>=c & ready=0 & x1=x & y1=y -> (b1'=min(b1+3,10)) & (b2'=max(b2-2,0)) & (b3'=max(b3-2,0)) & (b4'=max(b4-2,0)) & (step'=0) & (ready'=1);
  [update] step>=c & ready=0 & x2=x & y2=y -> (b2'=min(b2+3,10)) & (b1'=max(b1-2,0)) & (b3'=max(b3-2,0)) & (b4'=max(b4-2,0)) & (step'=0) & (ready'=1);
  [update] step>=c & ready=0 & x3=x & y3=y -> (b3'=min(b3+3,10)) & (b2'=max(b2-2,0)) & (b1'=max(b1-2,0)) & (b4'=max(b4-2,0)) & (step'=0) & (ready'=1);
  [update] step>=c & ready=0 & x4=x & y4=y -> (b4'=min(b4+3,10)) & (b2'=max(b2-2,0)) & (b3'=max(b3-2,0)) & (b1'=max(b4-2,0)) & (step'=0) & (ready'=1);

  // wenn kein aussichtsreichster Kandidat vorliegt, ersetze Kandidaten mit niedrigsten belief mit Ground Truth [x,y]
  [update] step>=c & ready=0 & noMatch & (b1<=b2) & (b1<=b3) & (b1<=b4) -> (x1'=x) & (y1'=y) & (b1'=2) & (step'=0) & (ready'=1);
  [update] step>=c & ready=0 & noMatch & (b1>b2) & (b2<=b3) & (b2<=b4) -> (x2'=x) & (y2'=y) & (b2'=2) & (step'=0) & (ready'=1);
  [update] step>=c & ready=0 & noMatch & (b1>b2) & (b1>b3) & (b3<=b4) -> (x3'=x) & (y3'=y) & (b3'=2) & (step'=0) & (ready'=1);
  [update] step>=c & ready=0 & noMatch & (b1>b2) & (b1>b3) & (b1>b4) -> (x4'=x) & (y4'=y) & (b4'=2) & (step'=0) & (ready'=1);

  [skip_update] step<c & ready=0 -> (step'=step+1) & (ready'=1);
endmodule

rewards "cost" 
  [east] true : 1; 
  [west] true : 1; 
  [north] true : 1; 
  [south] true : 1; 
  [update] true : 5;
endrewards 

// neuer reward: je unsicher Wissenszustand (belief), desto höher Kosten
rewards "uncertainty-belief"
  true : (3-b1) + (3-b2) + (3-b3) + (3-b4);
endrewards

