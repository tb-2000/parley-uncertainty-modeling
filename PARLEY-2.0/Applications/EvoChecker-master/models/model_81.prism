formula belief_u_5 = belief_state=5 | belief_state=13 | belief_state=19 | belief_state=48 | belief_state=61 | belief_state=65 | belief_state=69 | belief_state=72 | belief_state=75 | belief_state=89 | belief_state=96 | belief_state=98;
formula belief_u_6 = belief_state=3 | belief_state=14 | belief_state=37 | belief_state=40 | belief_state=50 | belief_state=52 | belief_state=62 | belief_state=66 | belief_state=68 | belief_state=76 | belief_state=79 | belief_state=91 | belief_state=99;
