formula hasCrashed = (1=0) | (x=0 & y=1) | (x=0 & y=4) | (x=0 & y=7) | (x=0 & y=9) | (x=1 & y=4) | (x=1 & y=5) | (x=1 & y=8) | (x=2 & y=2) | (x=2 & y=4) | (x=2 & y=7) | (x=3 & y=1) | (x=3 & y=7) | (x=4 & y=4) | (x=4 & y=8) | (x=4 & y=9) | (x=5 & y=2) | (x=5 & y=7) | (x=5 & y=8) | (x=5 & y=9) | (x=6 & y=2) | (x=6 & y=5) | (x=6 & y=8) | (x=6 & y=9) | (x=7 & y=1) | (x=7 & y=2) | (x=7 & y=3) | (x=7 & y=6) | (x=7 & y=9) | (x=8 & y=1) | (x=8 & y=2) | (x=8 & y=3) | (x=9 & y=5) | (x=9 & y=6) ;

formula belief_u_1 = belief_state=17 | belief_state=27 | belief_state=32 | belief_state=33 | belief_state=97;
