// Gaussian uncertainty level -> raw MSE threshold
// level 1 -> MSE >= 80000
// level 2 -> MSE >= 160000
// level 3 -> MSE >= 234400
// level 4 -> MSE >= 319200
// level 5 -> MSE >= 398800
// level 6 -> MSE >= 485000
// level 7 -> MSE >= 571500
// level 8 -> MSE >= 659000
// level 9 -> MSE >= 743700
// level 10 -> MSE >= 834600
const int N=9;
const int xstart=0;
const int ystart=0;
const int xtarget=9;
const int ytarget=9;
const double p=0.01;

