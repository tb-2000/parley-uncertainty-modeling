dtmc
// Gaussian uncertainty level -> raw MSE threshold
// level 1 -> MSE >= 80000
// level 2 -> MSE >= 160000
// level 3 -> MSE >= 243200
// level 4 -> MSE >= 319000
// level 5 -> MSE >= 398800
// level 6 -> MSE >= 477200
// level 7 -> MSE >= 541800
// level 8 -> MSE >= 607800
// level 9 -> MSE >= 675200
// level 10 -> MSE >= 751900
const int max_gaussian_uncertainty = 1;
const int N=9;
const int xstart=0;
const int ystart=0;
const int xtarget=9;
const int ytarget=9;
const double p=0.01;

