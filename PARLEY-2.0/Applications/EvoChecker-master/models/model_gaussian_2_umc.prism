module Turn
  t : [0..3] init 0;
  [east] (t=0) -> (t'=1);
  [west] (t=0) -> (t'=1);
  [north] (t=0) -> (t'=1);
  [south] (t=0) -> (t'=1);

  [check] (t=1) -> (t'=2);
  [URC] (t=2) -> (t'=3);

  [update] (t=3) -> (t'=0);
  [skip_update] (t=3) -> (t'=0);
endmodule
