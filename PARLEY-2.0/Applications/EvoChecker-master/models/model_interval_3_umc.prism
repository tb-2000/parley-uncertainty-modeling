module Knowledge
  xhat : [0..N] init xstart;
  yhat : [0..N] init ystart;
  xradius : [0..N] init 0;
  yradius : [0..N] init 0;
  ready : [0..1] init 1;

  [west] ready=1 ->
    (xhat'=max(xhat-1, 0)) &
    (xradius'=min(xradius+2, N)) &
    (yradius'=min(yradius+1, N)) &
    (ready'=0);
  [east] ready=1 ->
    (xhat'=min(xhat+1, N)) &
    (xradius'=min(xradius+2, N)) &
    (yradius'=min(yradius+1, N)) &
    (ready'=0);
  [south] ready=1 ->
    (yhat'=max(yhat-1, 0)) &
    (xradius'=min(xradius+1, N)) &
    (yradius'=min(yradius+2, N)) &
    (ready'=0);
  [north] ready=1 ->
    (yhat'=min(yhat+1, N)) &
    (xradius'=min(xradius+1, N)) &
    (yradius'=min(yradius+2, N)) &
    (ready'=0);

  [update] update_required & ready=0 ->
    (xhat'=x) & (yhat'=y) &
    (xradius'=0) & (yradius'=0) &
    (ready'=1);
  [skip_update] !update_required & ready=0 -> (ready'=1);
endmodule

rewards "cost" 
  [east] true : 1; 
  [west] true : 1; 
  [north] true : 1; 
  [south] true : 1; 
  [update] true : 5;
endrewards 


